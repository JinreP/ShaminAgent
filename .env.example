# Server-only. Copy to .env.local. Never use NEXT_PUBLIC_ for credentials.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=zahagent
MERCHANT_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Set to a model available to your Gemini account; no implicit model fallback.
GEMINI_MODEL=
MERCHANT_SPEECH_PROVIDER=disabled
# Existing Buyer demo setting, retained for compatibility.
DEMO_SIGNING_SECRET=

# Local merchant administration demo only. Always disabled in production.
MERCHANT_DEMO_ENABLED=false
MERCHANT_DEMO_ORIGIN=http://localhost:3000
# Generate two different random secrets of at least 32 characters; never commit values.
MERCHANT_DEMO_ACCESS_KEY=
MERCHANT_DEMO_SESSION_SECRET=
# Optional: export this in the shell for npm test (the runner does not load .env.local).
# Disposable replica-set only; unique test databases are dropped.
MERCHANT_TEST_MONGODB_URI=
