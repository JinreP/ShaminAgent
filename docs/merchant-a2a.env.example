# Phase 3 нэмэлт тохиргоо. MongoDB болон одоогийн credential-ийг өөрчлөхгүй.
# Доорх утгуудыг хөгжүүлэгч өөрийн .env.local файлд тохируулна.
MERCHANT_A2A_ORIGIN=http://localhost:3000
MERCHANT_A2A_AUTH_MODE=demo
MERCHANT_A2A_DEMO_ENABLED=true
# Хамгийн багадаа 32 тэмдэгттэй тусдаа санамсаргүй нууц утга оруулна.
MERCHANT_A2A_DEMO_TOKEN=
MERCHANT_A2A_DEMO_BUYER_ID=demo-buyer

# Бодит орчин: MERCHANT_A2A_AUTH_MODE=jwt, HTTPS нийтийн хаяг шаардлагатай.
# Үнэмлэх баталгаажуулах өөрийн үйлчилгээний албан ёсны хаяг, issuer, audience-г оруулна.
# Шинэ endpoint зохиож хэрэглэхгүй. Demo token бодит орчинд ажиллахгүй.
MERCHANT_A2A_JWKS_URI=
MERCHANT_A2A_ISSUER=
MERCHANT_A2A_AUDIENCE=
