# Phase 4-ийн нэмэлт тохиргоо. Энэ файлыг бүхлээр нь одоогийн .env дээр дарж хуулж болохгүй.
# Одоо байгаа MONGODB_URI, MONGODB_DB, A2A болон Gemini credentials-ийг хэвээр ашиглана.
# Нууц хувьсагчдад NEXT_PUBLIC_ угтвар хэрэглэж болохгүй.

# Ботыг зөвхөн шаардлагатай орчинд true болгож асаана.
MERCHANT_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# production нь администратороор зөвшөөрсөн холбоос ашиглана.
# Локал demo горим: AUTH_MODE=demo, DEMO_ENABLED=true, NODE_ENV нь production биш байна.
MERCHANT_TELEGRAM_AUTH_MODE=production
MERCHANT_TELEGRAM_DEMO_ENABLED=false

# Gemini structured output дэмждэг, өөрийн эрхтэй загварыг тохируулна.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# json: JSON MIME + бүтцийн prompt заавар + strict Zod; default, бодит smoke шалгасан.
# schema: албан ёсны responseSchema opt-in; загварын upstream schema нийцлийг тусад нь шалгана.
GEMINI_STRUCTURED_OUTPUT_MODE=json
# Өмнөх MERCHANT_AI_PROVIDER=gemini хувьсагч дэмжигдэнэ.
# AI_PROVIDER=oyu нь MERCHANT_AI_PROVIDER=oyullm-тэй ижил сонголт.
# Хоёуланг нь тохируулбал сонголт нь нийцсэн байх шаардлагатай.

MERCHANT_SPEECH_PROVIDER=disabled
# OyuLLM болон Anir нь тохируулагдаагүй adapter; одоогоор API хүсэлт хийдэггүй.
